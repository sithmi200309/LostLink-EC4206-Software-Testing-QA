    {
      "name": "Seed 20 items (User A)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.collectionVariables.get(\"json_web_token_0s92\");\r",
              "\r",
              "const items = [\r",
              "  [\"Lost\",\"Blue backpack\",\"Bags\",\"Library 2nd floor\",\"2026-11-20\",\"Blue backpack with a laptop sleeve and two notebooks inside.\"],\r",
              "  [\"Found\",\"Black umbrella\",\"Accessories\",\"Main canteen\",\"2026-11-19\",\"Folding black umbrella left on a table near the entrance.\"],\r",
              "  [\"Lost\",\"Casio fx-991ES calculator\",\"Electronics\",\"Lecture Hall 3\",\"2026-11-18\",\"Scientific calculator with my initials scratched on the back.\"],\r",
              "  [\"Found\",\"Student ID card\",\"Documents\",\"Faculty bus stop\",\"2026-11-21\",\"University ID card found on the bench at the bus stop.\"],\r",
              "  [\"Lost\",\"Silver water bottle\",\"Personal Items\",\"Gym changing room\",\"2026-11-17\",\"Steel water bottle with a dent near the cap and a blue sticker.\"],\r",
              "  [\"Found\",\"Wireless earbuds\",\"Electronics\",\"Computer lab 2\",\"2026-11-16\",\"White earbuds in a charging case left beside a lab computer.\"],\r",
              "  [\"Lost\",\"Engineering drawing set\",\"Stationery\",\"Drawing office\",\"2026-11-15\",\"Drawing instrument set in a grey box with compass and set squares.\"],\r",
              "  [\"Found\",\"Grey hoodie\",\"Clothing\",\"Sports ground pavilion\",\"2026-11-14\",\"Grey zip hoodie size M found on the pavilion steps.\"],\r",
              "  [\"Lost\",\"Laptop charger\",\"Electronics\",\"Study area near library\",\"2026-11-13\",\"Black 65W laptop charger with a frayed cable near the plug.\"],\r",
              "  [\"Found\",\"House keys\",\"Personal Items\",\"Car park B\",\"2026-11-12\",\"Bunch of three keys on a red keyring found near the gate.\"],\r",
              "  [\"Lost\",\"Spiral notebook\",\"Stationery\",\"Lecture Hall 1\",\"2026-11-11\",\"A4 spiral notebook with Structural Analysis notes inside.\"],\r",
              "  [\"Found\",\"Prescription glasses\",\"Accessories\",\"Department office\",\"2026-11-10\",\"Black framed glasses in a brown case handed in at the office.\"],\r",
              "  [\"Lost\",\"Wallet\",\"Personal Items\",\"Main canteen\",\"2026-11-09\",\"Brown leather wallet with bank cards and some cash inside.\"],\r",
              "  [\"Found\",\"USB flash drive\",\"Electronics\",\"Computer lab 1\",\"2026-11-08\",\"32GB flash drive left plugged into a lab machine.\"],\r",
              "  [\"Lost\",\"Lab coat\",\"Clothing\",\"Materials lab\",\"2026-11-07\",\"White lab coat with a name tag sewn inside the collar.\"],\r",
              "  [\"Found\",\"Hostel room key\",\"Personal Items\",\"Hostel common room\",\"2026-11-06\",\"Single key with a numbered plastic tag found on a sofa.\"],\r",
              "  [\"Lost\",\"Black handbag\",\"Bags\",\"Auditorium\",\"2026-11-05\",\"Small black handbag with a phone charger and lip balm inside.\"],\r",
              "  [\"Found\",\"Wrist watch\",\"Accessories\",\"Swimming pool area\",\"2026-11-04\",\"Digital wrist watch with a black rubber strap found near lockers.\"],\r",
              "  [\"Lost\",\"Certificate folder\",\"Documents\",\"Admin building\",\"2026-11-03\",\"Clear plastic folder with certificate copies inside.\"],\r",
              "  [\"Found\",\"Pencil case\",\"Stationery\",\"Library ground floor\",\"2026-11-02\",\"Green pencil case with pens and a highlighter set inside.\"]\r",
              "];\r",
              "\r",
              "items.forEach(([status, name, category, location, date, description], i) => {\r",
              "  pm.sendRequest({\r",
              "    url: \"http://localhost:5000/api/items\",\r",
              "    method: \"POST\",\r",
              "    header: [\r",
              "      { key: \"Content-Type\", value: \"application/json\" },\r",
              "      { key: \"Authorization\", value: \"Bearer \" + token }\r",
              "    ],\r",
              "    body: {\r",
              "      mode: \"raw\",\r",
              "      raw: JSON.stringify({ status, name, category, location, date, description })\r",
              "    }\r",
              "  }, (err, res) => {\r",
              "    console.log(`Item ${i + 1} (${name}): ` + (err ? err : res.code));\r",
              "  });\r",
              "});"
            ],
            "packages": {},
            "requests": {},
            "type": "text/javascript"
          }
        }
